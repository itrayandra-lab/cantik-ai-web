server {
    listen 80;
    listen [::]:80;
    server_name cantik.ai www.cantik.ai;

    # Redirect HTTP ke HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name cantik.ai www.cantik.ai;

    # SSL - sesuaikan path certificate
    ssl_certificate     /etc/letsencrypt/live/cantik.ai/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cantik.ai/privkey.pem;

    # Root directory - SESUAIKAN dengan lokasi project di server
    root /var/www/cantik.ai;
    index index.php index.html;

    # Charset
    charset utf-8;

    # Logs
    access_log /var/log/nginx/cantik.ai.access.log;
    error_log  /var/log/nginx/cantik.ai.error.log;

    # ── STATIC ASSETS ─────────────────────────────────────
    location ~* \.(css|js|png|jpg|jpeg|gif|ico|svg|webp|avif|woff|woff2|ttf|mp4|webm|lottie)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # ── ADMIN ─────────────────────────────────────────────
    location /admin {
        # Rewrite /admin/* → /pages/admin/*
        rewrite ^/admin/?$           /pages/admin/index.php last;
        rewrite ^/admin/(.+\.php)$   /pages/admin/$1        last;
        rewrite ^/admin/(.+)$        /pages/admin/$1        last;
    }

    # ── BLOG ──────────────────────────────────────────────
    location /blog {
        # /blog/slug → pages/blog/index.php?slug=slug
        rewrite ^/blog/([a-z0-9][a-z0-9\-]*)/?$ /pages/blog/index.php?slug=$1 last;
        # /blog/ → pages/blog/index.php
        rewrite ^/blog/?$ /pages/blog/index.php last;
    }

    # ── HOME ──────────────────────────────────────────────
    location = / {
        try_files /pages/index.html =404;
    }

    location = /home {
        try_files /pages/index.html =404;
    }

    # ── PHP HANDLER ───────────────────────────────────────
    location ~ \.php$ {
        # SESUAIKAN dengan PHP-FPM socket/port di server Anda
        # Option 1 - Unix socket (lebih umum di Ubuntu/Debian):
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
        # Option 2 - TCP port:
        # fastcgi_pass 127.0.0.1:9000;

        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;

        fastcgi_buffer_size 128k;
        fastcgi_buffers 4 256k;
        fastcgi_busy_buffers_size 256k;
    }

    # ── SECURITY ──────────────────────────────────────────
    # Blokir akses langsung ke pages/ dari URL
    location ^~ /pages/admin {
        # Izinkan akses PHP (diproses via /admin rewrite)
        location ~ \.php$ {
            fastcgi_pass unix:/run/php/php8.2-fpm.sock;
            fastcgi_index index.php;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            include fastcgi_params;
        }
    }

    location ^~ /pages/blog {
        location ~ \.php$ {
            fastcgi_pass unix:/run/php/php8.2-fpm.sock;
            fastcgi_index index.php;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            include fastcgi_params;
        }
    }

    # Blokir akses ke file sensitif
    location ~ /\.(git|env|htaccess) {
        deny all;
    }

    location ~ \.(sql|md|json|lock)$ {
        deny all;
    }
}
